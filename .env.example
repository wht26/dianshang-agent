# Documentation only. The app reads OS environment variables, not this file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# auto: DeepSeek if configured, otherwise local excerpts; demo: local excerpts only
WANG_MODE=auto
# Required: PostgreSQL persistent data and Redis coordination; no SQLite fallback.
# On Windows run . ./setup-storage.ps1 to configure user/process variables safely.
DATABASE_URL=
REDIS_URL=
WANG_REDIS_PREFIX=wang
WANG_CHAT_RATE_LIMIT=60
WANG_CHAT_RATE_WINDOW=60
# Docker Compose passwords; generated by setup-storage.ps1, never commit real values.
WANG_POSTGRES_PASSWORD=
WANG_REDIS_PASSWORD=
# Optional path to your complete shop/product JSON; takes precedence over the shop saved through the UI.
WANG_SHOP_FILE=
# Optional absolute directory of your own UTF-8 Markdown documents.
WANG_KNOWLEDGE_DIR=

# Commerce credentials: OS environment variables only. Never commit real values.
WANG_ADMIN_TOKEN=
# HTTPS normalized merchant gateways (not official platform URLs).
WANG_NATIVE_GATEWAY_URL=
WANG_NATIVE_GATEWAY_TOKEN=
WANG_TAOBAO_GATEWAY_URL=
WANG_TAOBAO_GATEWAY_TOKEN=
WANG_DOUYIN_GATEWAY_URL=
WANG_DOUYIN_GATEWAY_TOKEN=
